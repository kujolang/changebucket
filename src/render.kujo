# ChangeBudget :: render
#
# Pure presentation: turn an analysis model into a compact text report or a
# markdown report. Nothing here touches disk or git. (JSON output is just
# `to_json_pretty(model)` and lives in the CLI.)
#
# Loops are index/`while` based so the module compiles under the checker.

from src.util import commas, pad_right
from src.classify import category_order

# Friendly label for a category key.
func cat_label(key) {
    if key == "dependency_manifests" {
        return "Dependency manifests"
    }
    if key == "lockfiles" {
        return "Lockfiles"
    }
    if key == "ci" {
        return "CI"
    }
    if key == "source" {
        return "Source"
    }
    if key == "tests" {
        return "Tests"
    }
    if key == "docs" {
        return "Docs"
    }
    if key == "config" {
        return "Config"
    }
    if key == "generated" {
        return "Generated"
    }
    if key == "scripts" {
        return "Scripts"
    }
    return "Other"
}

func mark(ok) {
    if ok {
        return "PASS"
    }
    return "FAIL"
}

# Files sorted by churn descending, truncated to `n`. A copy is sorted in place
# via selection sort (no sort builtin is relied on).
export func top_by_churn(files, n) {
    mut arr := []
    mut i := 0
    while i < len(files) {
        arr = push(arr, files[i])
        i = i + 1
    }
    mut a := 0
    while a < len(arr) {
        mut best := a
        mut b := a + 1
        while b < len(arr) {
            if arr[b]["churn"] > arr[best]["churn"] {
                best = b
            }
            b = b + 1
        }
        if best != a {
            tmp := arr[a]
            arr[a] := arr[best]
            arr[best] := tmp
        }
        a = a + 1
    }
    mut out := []
    mut k := 0
    while k < len(arr) && k < n {
        out = push(out, arr[k])
        k = k + 1
    }
    return out
}

# Budget lines for the text report, derived from the config so each configured
# constraint shows its limit and a PASS/FAIL marker.
func budget_text_lines(model, cfg) {
    s := model["summary"]
    cats := model["categories"]
    mut lines := []
    if type(cfg["max_files"]) != "null" {
        lines = push(lines, "- Max files: " + commas(cfg["max_files"]) + " [" + mark(s["files_changed"] <= cfg["max_files"]) + "] (actual " + commas(s["files_changed"]) + ")")
    }
    if type(cfg["max_churn"]) != "null" {
        lines = push(lines, "- Max churn: " + commas(cfg["max_churn"]) + " [" + mark(s["total_churn"] <= cfg["max_churn"]) + "] (actual " + commas(s["total_churn"]) + ")")
    }
    if type(cfg["max_additions"]) != "null" {
        lines = push(lines, "- Max additions: " + commas(cfg["max_additions"]) + " [" + mark(s["lines_added"] <= cfg["max_additions"]) + "] (actual " + commas(s["lines_added"]) + ")")
    }
    if type(cfg["max_deletions"]) != "null" {
        lines = push(lines, "- Max deletions: " + commas(cfg["max_deletions"]) + " [" + mark(s["lines_deleted"] <= cfg["max_deletions"]) + "] (actual " + commas(s["lines_deleted"]) + ")")
    }
    if cfg["no_deletes"] == true {
        lines = push(lines, "- Deletes allowed: no [" + mark(s["files_deleted"] == 0) + "]")
    }
    if cfg["no_dependency_changes"] == true {
        lines = push(lines, "- Dependency changes allowed: no [" + mark(len(cats["dependency_manifests"]) == 0) + "]")
    }
    if cfg["no_lockfile_changes"] == true {
        lines = push(lines, "- Lockfile changes allowed: no [" + mark(len(cats["lockfiles"]) == 0) + "]")
    }
    if cfg["no_config_changes"] == true {
        lines = push(lines, "- Config changes allowed: no [" + mark(len(cats["config"]) == 0) + "]")
    }
    if cfg["no_generated_changes"] == true {
        lines = push(lines, "- Generated changes allowed: no [" + mark(len(cats["generated"]) == 0) + "]")
    }
    return lines
}

# Compact, human-readable terminal report.
export func render_text(model, cfg, show_budget) {
    s := model["summary"]
    cats := model["categories"]
    mut out := []
    out = push(out, "ChangeBudget")
    out = push(out, "")
    out = push(out, "Base: " + model["base"])
    out = push(out, "Head: " + model["head"])
    out = push(out, "")
    out = push(out, "Summary:")
    out = push(out, "- Files changed: " + commas(s["files_changed"]))
    out = push(out, "- Lines added: " + commas(s["lines_added"]))
    out = push(out, "- Lines deleted: " + commas(s["lines_deleted"]))
    out = push(out, "- Total line churn: " + commas(s["total_churn"]))
    out = push(out, "- Files added: " + commas(s["files_added"]))
    out = push(out, "- Files modified: " + commas(s["files_modified"]))
    out = push(out, "- Files deleted: " + commas(s["files_deleted"]))
    out = push(out, "- Binary files: " + commas(s["binary_files"]))
    out = push(out, "- Risk level: " + s["risk_level"])
    out = push(out, "")
    out = push(out, "Categories:")
    order := category_order()
    mut ci := 0
    while ci < len(order) {
        key := order[ci]
        count := len(cats[key])
        if count > 0 {
            out = push(out, "- " + pad_right(cat_label(key) + ":", 22) + commas(count))
        }
        ci = ci + 1
    }

    largest := top_by_churn(model["files"], 5)
    if len(largest) > 0 {
        out = push(out, "")
        out = push(out, "Largest changes:")
        mut li := 0
        while li < len(largest) {
            f := largest[li]
            out = push(out, "- " + f["path"] + " (" + f["status"] + ", +" + commas(f["additions"]) + " -" + commas(f["deletions"]) + ", churn " + commas(f["churn"]) + ")")
            li = li + 1
        }
    }

    if show_budget && model["budget"]["checked"] == true {
        out = push(out, "")
        out = push(out, "Budget:")
        blines := budget_text_lines(model, cfg)
        if len(blines) == 0 {
            out = push(out, "- (no constraints set)")
        } else {
            mut bi := 0
            while bi < len(blines) {
                out = push(out, blines[bi])
                bi = bi + 1
            }
        }
        out = push(out, "")
        if model["budget"]["passed"] == true {
            out = push(out, "Result: within budget")
        } else {
            out = push(out, "Result: budget exceeded")
            failures := model["budget"]["failures"]
            mut fi := 0
            while fi < len(failures) {
                out = push(out, "  - " + failures[fi])
                fi = fi + 1
            }
        }
    }

    return join(out, "\n")
}

func md_row(cells) {
    return "| " + join(cells, " | ") + " |"
}

# Clean markdown report.
export func render_markdown(model, cfg, show_budget) {
    s := model["summary"]
    cats := model["categories"]
    mut out := []
    out = push(out, "# ChangeBudget Report")
    out = push(out, "")
    out = push(out, "Generated: " + model["generated_at"])
    out = push(out, "")
    out = push(out, "Base: `" + model["base"] + "`  Head: `" + model["head"] + "`")
    out = push(out, "")
    out = push(out, "## Summary")
    out = push(out, "")
    out = push(out, md_row(["Metric", "Value"]))
    out = push(out, md_row(["---", "---:"]))
    out = push(out, md_row(["Files changed", commas(s["files_changed"])]))
    out = push(out, md_row(["Files added", commas(s["files_added"])]))
    out = push(out, md_row(["Files modified", commas(s["files_modified"])]))
    out = push(out, md_row(["Files deleted", commas(s["files_deleted"])]))
    out = push(out, md_row(["Binary files", commas(s["binary_files"])]))
    out = push(out, md_row(["Lines added", commas(s["lines_added"])]))
    out = push(out, md_row(["Lines deleted", commas(s["lines_deleted"])]))
    out = push(out, md_row(["Total churn", commas(s["total_churn"])]))
    out = push(out, md_row(["Risk level", s["risk_level"]]))
    out = push(out, "")

    if show_budget && model["budget"]["checked"] == true {
        out = push(out, "## Budget Result")
        out = push(out, "")
        if model["budget"]["passed"] == true {
            out = push(out, "Status: **within budget**")
        } else {
            out = push(out, "Status: **budget exceeded**")
        }
        out = push(out, "")
        failures := model["budget"]["failures"]
        if len(failures) > 0 {
            mut fi := 0
            while fi < len(failures) {
                out = push(out, "- " + failures[fi])
                fi = fi + 1
            }
            out = push(out, "")
        }
    }

    out = push(out, "## File Categories")
    out = push(out, "")
    out = push(out, md_row(["Category", "Count"]))
    out = push(out, md_row(["---", "---:"]))
    order := category_order()
    mut ci := 0
    while ci < len(order) {
        key := order[ci]
        count := len(cats[key])
        if count > 0 {
            out = push(out, md_row([cat_label(key), commas(count)]))
        }
        ci = ci + 1
    }
    out = push(out, "")

    largest := top_by_churn(model["files"], 10)
    out = push(out, "## Largest Changes")
    out = push(out, "")
    out = push(out, md_row(["File", "Status", "+", "-", "Churn"]))
    out = push(out, md_row(["---", "---", "---:", "---:", "---:"]))
    mut li := 0
    while li < len(largest) {
        f := largest[li]
        out = push(out, md_row(["`" + f["path"] + "`", f["status"], commas(f["additions"]), commas(f["deletions"]), commas(f["churn"])]))
        li = li + 1
    }
    out = push(out, "")

    return join(out, "\n")
}
