# ChangeBucket test suite.
#
# A self-contained, filesystem-isolated harness. It exercises the library
# modules directly (the same functions the CLI delegates to), using throwaway
# git repos under the system temp directory. It needs no network, no API key,
# and no global machine state.
#
# Run with:
#   ./tests/run.sh
# Exits non-zero if any assertion fails.
#
# NOTE: the built-in `test "..." {}` framework cannot see file-level imports on
# the current runtime, so this hand-rolled harness is used instead. It runs on
# the standard launcher path where module imports work normally.

from src.classify import classify
from src.analyze import analyze, risk_level
from src.budget import empty_config, evaluate, has_constraints
from src.render import render_text, render_markdown
from src.util import commas

mut passed := 0
mut failed := 0

func check(cond, name) {
    if cond == true {
        passed = passed + 1
    } else {
        failed = failed + 1
        print("  FAIL: " + name)
    }
}

func check_eq(actual, expected, name) {
    if "${actual}" == "${expected}" {
        passed = passed + 1
    } else {
        failed = failed + 1
        print("  FAIL: " + name + " (expected ${expected}, got ${actual})")
    }
}

func has(arr, value) {
    for item in arr {
        if item == value {
            return true
        }
    }
    return false
}

func sh(cmd) {
    return execute_status(cmd)
}

func run_cli(argline) {
    return sh(KUJO_BIN + " run changebucket.kujo -- " + argline + " > " + WORK + "/cli.out 2>&1")
}

# write_file refuses to overwrite an existing path on this runtime, so replace.
func put(path, content) {
    if file_exists(path) {
        delete_file(path)
    }
    write_file(path, content)
}

WORK := join_path(env_or("TMPDIR", "/tmp"), "changebucket_selftest")
REPO := join_path(WORK, "repo")
PLAIN := join_path(WORK, "plain")
SPECIAL := join_path(WORK, "special")
KUJO_BIN := env_or("KUJO", "kujo")

mut C1 := ""

func setup() {
    sh("rm -rf " + WORK)
    create_dir(WORK)
    create_dir(PLAIN)
    create_dir(REPO)
    create_dir(SPECIAL)
    create_dir(join_path(REPO, "src"))
    create_dir(join_path(REPO, "docs"))
    sh("git -C " + REPO + " init -q")
    sh("git -C " + REPO + " config user.email t@t.com")
    sh("git -C " + REPO + " config user.name test")
    # initial commit
    put(join_path(REPO, "src/app.js"), "a\nb\nc\n")
    put(join_path(REPO, "src/old.js"), "x\ny\n")
    put(join_path(REPO, "package.json"), "{\"name\":\"x\"}\n")
    put(join_path(REPO, "Cargo.lock"), "locked\n")
    sh("git -C " + REPO + " add -A")
    sh("git -C " + REPO + " commit -qm init")
    r := sh("git -C " + REPO + " rev-parse HEAD")
    C1 = trim(r.stdout)
    # worktree changes:
    #   app.js modified (+2), old.js deleted (-2), package.json modified (+1),
    #   Cargo.lock modified (+1), docs/guide.md added (+1), image.png added (binary)
    put(join_path(REPO, "src/app.js"), "a\nb\nc\nd\ne\n")
    sh("rm " + join_path(REPO, "src/old.js"))
    put(join_path(REPO, "package.json"), "{\"name\":\"x\",\"v\":2}\n")
    put(join_path(REPO, "Cargo.lock"), "locked\nmore\n")
    put(join_path(REPO, "docs/guide.md"), "# Guide\n")
    put(join_path(REPO, "image.png"), "pretend-binary\n")

    sh("git -C " + SPECIAL + " init -q")
    sh("git -C " + SPECIAL + " config user.email t@t.com")
    sh("git -C " + SPECIAL + " config user.name test")
    put(join_path(SPECIAL, "seed.txt"), "seed\n")
    sh("git -C " + SPECIAL + " add -A")
    sh("git -C " + SPECIAL + " commit -qm init")
    put(join_path(SPECIAL, " leading.js"), "space\n")
    put(join_path(SPECIAL, "tab\tname.js"), "tab\n")
    put(join_path(SPECIAL, "line\nname.js"), "newline\n")
    put(join_path(SPECIAL, "target.txt"), "one\ntwo\nthree\nfour\nfive\n")
    sh("ln -s target.txt " + join_path(SPECIAL, "link.js"))
    create_dir(join_path(SPECIAL, "nested"))
    put(join_path(SPECIAL, "nested/new.js"), "nested\n")
}

func teardown() {
    sh("rm -rf " + WORK)
}

# --- classification (pure) ---------------------------------------------
func test_classify() {
    check(has(classify("src/app.ts"), "source"), "ts under src is source")
    check(has(classify("packages/core/index.rs"), "source"), "rs is source")
    check(has(classify("tests/foo.test.js"), "tests"), "*.test.js is tests")
    check(has(classify("tests/foo.test.js"), "source") == false, "test file not also source")
    check(has(classify("src/widget_test.go"), "tests"), "_test.go is tests")
    check(has(classify("README.md"), "docs"), "README is docs")
    check(has(classify("docs/guide.mdx"), "docs"), "docs/ mdx is docs")
    check(has(classify("LICENSE"), "docs"), "LICENSE is docs")
    check(has(classify("package.json"), "config"), "package.json is config")
    check(has(classify("package.json"), "dependency_manifests"), "package.json is dependency manifest")
    check(has(classify("Cargo.toml"), "dependency_manifests"), "Cargo.toml is dependency manifest")
    check(has(classify("requirements-dev.txt"), "dependency_manifests"), "requirements*.txt is manifest")
    check(has(classify("pnpm-lock.yaml"), "lockfiles"), "pnpm-lock is lockfile")
    check(has(classify("Cargo.lock"), "lockfiles"), "Cargo.lock is lockfile")
    check(has(classify(".github/workflows/ci.yml"), "ci"), "workflow is ci")
    check(has(classify("dist/bundle.js"), "generated"), "dist/ is generated")
    check(has(classify("app/main.min.js"), "generated"), "*.min.js is generated")
    check(has(classify("scripts/deploy.sh"), "scripts"), "scripts/ sh is scripts")
    check(has(classify("vite.config.ts"), "config"), "vite.config is config")
    check(has(classify("mystery.xyz"), "other"), "unknown is other")
    check(has(classify("rebuild/app.js"), "generated") == false, "generated directories require a full path segment")
    check(has(classify("undocs/guide.xyz"), "docs") == false, "docs directories require a full path segment")
    check(has(classify("descripts/task.xyz"), "scripts") == false, "scripts directories require a full path segment")
    check(has(classify("not.circleci/config.xyz"), "ci") == false, "CI directories require a full path segment")
}

func find_file(files, path) {
    for item in files {
        if item["path"] == path {
            return item
        }
    }
    return null
}

func test_special_paths() {
    m := analyze(SPECIAL, null, null)
    files := m["files"]
    check(type(find_file(files, " leading.js")) == "dict", "leading-space filename is preserved")
    check(type(find_file(files, "tab\tname.js")) == "dict", "tab filename is preserved")
    check(type(find_file(files, "line\nname.js")) == "dict", "newline filename is preserved")
    link := find_file(files, "link.js")
    check(type(link) == "dict", "untracked symlink is reported")
    check_eq(link["additions"], 1, "untracked symlink counts its link target as one line")

    from_subdir := analyze(join_path(SPECIAL, "nested"), null, null)
    check(type(find_file(from_subdir["files"], "nested/new.js")) == "dict", "subdirectory repo analysis keeps root-relative untracked paths")
}

# --- risk heuristic (pure) ---------------------------------------------
func test_risk() {
    check_eq(risk_level(3, 100, 0, 0, 0, 0, 0), "low", "small clean edit is low")
    check_eq(risk_level(10, 500, 0, 1, 1, 0, 0), "medium", "dep+lock mid-size is medium")
    check_eq(risk_level(30, 100, 0, 0, 0, 0, 0), "high", "many files is high")
    check_eq(risk_level(2, 2000, 0, 0, 0, 0, 0), "high", "huge churn is high")
    check_eq(risk_level(2, 50, 1, 0, 0, 0, 0), "high", "any delete is high")
    check_eq(risk_level(4, 150, 0, 0, 0, 1, 0), "high", "generated touched is high")
    check_eq(risk_level(8, 300, 0, 0, 0, 0, 1), "medium", "ci alone is medium not low")
}

# --- analyze over a real worktree --------------------------------------
func test_analyze_worktree() {
    m := analyze(REPO, null, null)
    s := m["summary"]
    check_eq(s["files_changed"], 6, "six files changed in worktree")
    check_eq(s["files_deleted"], 1, "one deleted file")
    check_eq(s["files_added"], 2, "two added files (guide + image)")
    check_eq(s["files_modified"], 3, "three modified files")
    check_eq(s["lines_added"], 5, "lines added summed")
    # old.js delete (-2) plus package.json's single-line replacement (-1) = 3
    check_eq(s["lines_deleted"], 3, "lines deleted summed")
    check_eq(s["total_churn"], 8, "churn is add+del")
    check_eq(s["binary_files"], 1, "image.png counted as binary")
    check_eq(s["risk_level"], "high", "delete forces high risk")
    cats := m["categories"]
    check_eq(len(cats["source"]), 2, "two source files (app.js, old.js)")
    check_eq(len(cats["docs"]), 1, "one docs file")
    check_eq(len(cats["lockfiles"]), 1, "one lockfile")
    check_eq(len(cats["dependency_manifests"]), 1, "one dependency manifest")
    check_eq(len(cats["other"]), 1, "image.png is other")
    check_eq(m["head"], "working tree", "head labelled working tree")
}

# --- analyze a commit range --------------------------------------------
func test_analyze_range() {
    sh("git -C " + REPO + " add -A")
    sh("git -C " + REPO + " commit -qm change")
    r := sh("git -C " + REPO + " rev-parse HEAD")
    c2 := trim(r.stdout)
    m := analyze(REPO, C1, c2)
    s := m["summary"]
    check(s["files_changed"] >= 5, "range sees the committed changes")
    check_eq(m["head"], c2, "range head label is the head sha")
    check(s["files_deleted"] >= 1, "range still detects the delete")
}

# --- budget checks ------------------------------------------------------
func test_budget() {
    m := analyze(REPO, null, null)

    tight := empty_config()
    tight["max_files"] := 3
    e1 := evaluate(m, tight)
    check_eq(e1["budget"]["passed"], false, "max-files 3 fails for 6 files")
    check(len(e1["budget"]["failures"]) >= 1, "failure reason recorded")

    loose := empty_config()
    loose["max_files"] := 100
    loose["max_churn"] := 1000
    e2 := evaluate(m, loose)
    check_eq(e2["budget"]["passed"], true, "generous budget passes")

    nodel := empty_config()
    nodel["no_deletes"] := true
    e3 := evaluate(m, nodel)
    check_eq(e3["budget"]["passed"], false, "no-deletes fails when a file is deleted")

    nolock := empty_config()
    nolock["no_lockfile_changes"] := true
    e4 := evaluate(m, nolock)
    check_eq(e4["budget"]["passed"], false, "no-lockfile-changes fails on Cargo.lock")

    check(has_constraints(loose) == true, "has_constraints true when limits set")
    check(has_constraints(empty_config()) == false, "has_constraints false for empty config")
}

# --- JSON output --------------------------------------------------------
func test_json() {
    m := analyze(REPO, null, null)
    j := to_json_pretty(m)
    parsed := parse_json(j)
    check(type(parsed) == "dict", "model serializes to a JSON object")
    check(has_key(parsed, "summary") == 1, "json has summary")
    check(has_key(parsed, "categories") == 1, "json has categories")
    check(has_key(parsed, "files") == 1, "json has files array")
}

# --- markdown + text output --------------------------------------------
func sample_render_model() {
    return {
        "base": "HEAD",
        "head": "working tree",
        "generated_at": "2026-06-01T00:00:00Z",
        "summary": {
            "files_changed": 2,
            "files_added": 1,
            "files_modified": 1,
            "files_deleted": 0,
            "files_renamed": 0,
            "binary_files": 0,
            "lines_added": 11,
            "lines_deleted": 1,
            "total_churn": 12,
            "risk_level": "low"
        },
        "categories": {
            "source": ["src/app.js"],
            "tests": [],
            "docs": ["README.md"],
            "config": [],
            "dependency_manifests": [],
            "lockfiles": [],
            "generated": [],
            "ci": [],
            "scripts": [],
            "other": []
        },
        "budget": {"checked": false, "passed": true, "failures": []},
        "files": [
            {"path": "src/app.js", "status": "modified", "additions": 10, "deletions": 1, "churn": 11, "binary": false, "categories": ["source"]},
            {"path": "README.md", "status": "added", "additions": 1, "deletions": 0, "churn": 1, "binary": false, "categories": ["docs"]}
        ]
    }
}

func test_render_exact() {
    m := sample_render_model()
    cfg := empty_config()

    expected_text := join([
        "ChangeBucket",
        "",
        "Base: HEAD",
        "Head: working tree",
        "",
        "Summary:",
        "- Files changed: 2",
        "- Lines added: 11",
        "- Lines deleted: 1",
        "- Total line churn: 12",
        "- Files added: 1",
        "- Files modified: 1",
        "- Files deleted: 0",
        "- Binary files: 0",
        "- Risk level: low",
        "",
        "Categories:",
        "- Source:               1",
        "- Docs:                 1",
        "",
        "Largest changes:",
        "- src/app.js (modified, +10 -1, churn 11)",
        "- README.md (added, +1 -0, churn 1)"
    ], "\n")
    check_eq(render_text(m, cfg, false), expected_text, "text report exact output")

    expected_md := join([
        "# ChangeBucket Report",
        "",
        "Generated: 2026-06-01T00:00:00Z",
        "",
        "Base: `HEAD`  Head: `working tree`",
        "",
        "## Summary",
        "",
        "| Metric | Value |",
        "| --- | ---: |",
        "| Files changed | 2 |",
        "| Files added | 1 |",
        "| Files modified | 1 |",
        "| Files deleted | 0 |",
        "| Binary files | 0 |",
        "| Lines added | 11 |",
        "| Lines deleted | 1 |",
        "| Total churn | 12 |",
        "| Risk level | low |",
        "",
        "## File Categories",
        "",
        "| Category | Count |",
        "| --- | ---: |",
        "| Source | 1 |",
        "| Docs | 1 |",
        "",
        "## Largest Changes",
        "",
        "| File | Status | + | - | Churn |",
        "| --- | --- | ---: | ---: | ---: |",
        "| `src/app.js` | modified | 10 | 1 | 11 |",
        "| `README.md` | added | 1 | 0 | 1 |",
        ""
    ], "\n")
    check_eq(render_markdown(m, cfg, false), expected_md, "markdown report exact output")
}

func test_render() {
    m := analyze(REPO, null, null)
    cfg := empty_config()
    cfg["max_files"] := 3
    e := evaluate(m, cfg)
    md := render_markdown(e, cfg, true)
    check(contains(md, "# ChangeBucket Report") == 1, "markdown has title")
    check(contains(md, "## Summary") == 1, "markdown has summary section")
    check(contains(md, "## File Categories") == 1, "markdown has categories section")
    check(contains(md, "## Largest Changes") == 1, "markdown has largest changes")
    check(contains(md, "Budget Result") == 1, "markdown shows budget result when checked")
    txt := render_text(e, cfg, true)
    check(contains(txt, "ChangeBucket") == 1, "text report has header")
    check(contains(txt, "Risk level:") == 1, "text report shows risk")
    check(contains(txt, "Result: budget exceeded") == 1, "text report shows budget failure")
}

func test_render_special_path() {
    m := sample_render_model()
    files := m["files"]
    first := files[0]
    first["path"] := "src/a|b`c\n.js"
    files[0] := first
    m["files"] := files
    md := render_markdown(m, empty_config(), false)
    check(contains(md, "a\\|b`c\\n.js") == 1, "markdown escapes pipes and control characters in paths")
    txt := render_text(m, empty_config(), false)
    check(contains(txt, "c\\n.js (modified") == 1, "text output keeps control characters on one line")
}

# --- non-git directory --------------------------------------------------
func test_non_git() {
    m := analyze(PLAIN, null, null)
    check(type(m) == "dict", "non-git returns a dict")
    check(has_key(m, "error") == 1, "non-git directory reports an error")
}

# --- public CLI success paths -------------------------------------------
func test_cli_success() {
    check_eq(run_cli("--help").exitcode, 0, "help exits 0")
    check(contains(read_file(WORK + "/cli.out"), "Usage:") == 1, "help prints usage")

    check_eq(run_cli("--version").exitcode, 0, "version exits 0")
    check(contains(read_file(WORK + "/cli.out"), "changebucket 1.0.0") == 1, "version prints stable banner")

    range_args := "--repo " + REPO + " --base " + C1 + " --head HEAD"
    check_eq(run_cli(range_args + " --json").exitcode, 0, "JSON range analysis exits 0")
    payload := parse_json(read_file(WORK + "/cli.out"))
    check(type(payload) == "dict", "JSON CLI output parses as one object")
    check_eq(payload["summary"]["files_changed"], 6, "JSON CLI reports the range file count")

    check_eq(run_cli("check " + range_args + " --max-files 3").exitcode, 1, "check enforces an exceeded budget")
    check_eq(run_cli(range_args + " --max-files 3").exitcode, 0, "default command reports but does not enforce budget")

    output_path := WORK + "/CHANGE_BUCKET.md"
    check_eq(run_cli(range_args + " --output " + output_path).exitcode, 0, "output option exits 0")
    check(file_exists(output_path), "output option writes markdown file")
    check(contains(read_file(output_path), "# ChangeBucket Report") == 1, "output file contains markdown report")
}

# --- invalid input ------------------------------------------------------
func test_invalid_input() {
    missing := analyze(REPO, "does-not-exist", null)
    check(has_key(missing, "error") == 1, "missing base ref reports an error")
    check(contains(missing["error"], "invalid git revision or range") == 1, "missing ref error names invalid range")

    unsafe := analyze(REPO, "HEAD;touch/tmp/changebucket-oops", null)
    check(has_key(unsafe, "error") == 1, "unsafe base ref reports an error")
    check(contains(unsafe["error"], "invalid --base ref") == 1, "unsafe ref is rejected before git")

    check_eq(run_cli("--definitely-unknown").exitcode, 2, "unknown option exits 2")
    check_eq(run_cli("--base").exitcode, 2, "missing option value exits 2")
    check_eq(run_cli("check --max-files nope").exitcode, 2, "non-numeric budget exits 2")
    check_eq(run_cli("check --max-files -1").exitcode, 2, "negative budget exits 2")
    check_eq(run_cli("--base does-not-exist").exitcode, 1, "invalid git ref exits 1")
    check_eq(run_cli("--json unexpected").exitcode, 2, "unexpected positional argument exits 2")
    check_eq(run_cli("check unexpected").exitcode, 2, "unexpected check argument exits 2")
    check_eq(run_cli("--json=false").exitcode, 2, "boolean option value exits 2")
    check_eq(run_cli("--base=").exitcode, 2, "empty option value exits 2")
    check_eq(run_cli("check --max-files 999999999999999999999999999999999999").exitcode, 2, "overflowing numeric budget exits 2")

    missing_output := WORK + "/missing/report.md"
    check_eq(run_cli("--output " + missing_output).exitcode, 1, "output write failure exits 1 without a runtime crash")
    check(contains(read_file(WORK + "/cli.out"), "error: could not write report") == 1, "output write failure is explained")
}

# --- util ---------------------------------------------------------------
func test_util() {
    check_eq(commas(1280), "1,280", "commas groups thousands")
    check_eq(commas(508), "508", "commas leaves small numbers")
    check_eq(commas(1000000), "1,000,000", "commas groups millions")
    check_eq(commas(0), "0", "commas handles zero")
}

# --- run all ------------------------------------------------------------
setup()
test_classify()
test_risk()
test_util()
test_analyze_worktree()
test_special_paths()
test_budget()
test_json()
test_render_exact()
test_render()
test_render_special_path()
test_analyze_range()
test_non_git()
test_cli_success()
test_invalid_input()
teardown()

print("")
print("ChangeBucket tests: ${passed} passed, ${failed} failed")
if failed > 0 {
    exit(1)
}
exit(0)
