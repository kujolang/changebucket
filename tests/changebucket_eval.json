{
  "name": "changebucket-launch-readiness",
  "version": "0.1.0",
  "tests": [
    {
      "name": "ChangeBucket entrypoint help succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "kujo run changebucket.kujo -- --help"
      }
    },
    {
      "name": "ChangeBucket wrapper help succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "./bin/changebucket --help"
      }
    },
    {
      "name": "ChangeBucket version succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "./bin/changebucket version"
      }
    },
    {
      "name": "ChangeBucket test harness succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "./tests/run.sh"
      }
    },
    {
      "name": "ChangeBucket package metadata exists",
      "check": "file_exists",
      "params": {
        "path": "kujo.toml"
      }
    }
  ]
}
